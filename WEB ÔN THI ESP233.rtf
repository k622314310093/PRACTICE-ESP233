    /* Theme Management */\
    function initTheme() \{\
      const savedTheme = localStorage.getItem('esp233_theme');\
      if (savedTheme) \{\
        isLightTheme = (savedTheme === 'light');\
      \} else \{\
        isLightTheme = true; // Default to bright theme\
      \}\
      applyTheme();\
    \}\
\
    function toggleTheme() \{\
      isLightTheme = !isLightTheme;\
      localStorage.setItem('esp233_theme', isLightTheme ? 'light' : 'dark');\
      applyTheme();\
    \}\
\
    function applyTheme() \{\
      const body = document.body;\
      const icon = document.getElementById('theme-toggle-icon');\
      const label = document.getElementById('theme-toggle-label');\
\
      if (isLightTheme) \{\
        body.classList.add('light-theme');\
        if (icon) icon.className = 'fa-solid fa-moon text-indigo-600';\
        if (label) label.textContent = 'Giao di\uc0\u7879 n T\u7889 i';\
      \} else \{\
        body.classList.remove('light-theme');\
        if (icon) icon.className = 'fa-solid fa-sun text-amber-400';\
        if (label) label.textContent = 'Giao di\uc0\u7879 n S\'e1ng';\
      \}\
    \}\
\
    function switchTab(tabId) \{\
      currentTab = tabId;\
      document.querySelectorAll('main > section').forEach(sec => sec.classList.add('hidden'));\
      document.getElementById(`tab-$\{tabId\}`).classList.remove('hidden');\
\
      // Update Nav styling\
      document.querySelectorAll('.nav-btn').forEach(btn => \{\
        btn.classList.remove('bg-brand-600', 'text-white', 'shadow');\
        btn.classList.add('text-slate-400');\
      \});\
      const activeNav = document.getElementById(`nav-$\{tabId\}`);\
      if(activeNav) \{\
        activeNav.classList.add('bg-brand-600', 'text-white', 'shadow');\
        activeNav.classList.remove('text-slate-400');\
      \}\
    \}\
\
    function populatePrompts() \{\
      const select = document.getElementById('prompt-select');\
      select.innerHTML = '';\
      espTopics.forEach((topic, idx) => \{\
        const opt = document.createElement('option');\
        opt.value = idx;\
        opt.textContent = `[$\{topic.type\}] $\{topic.vietnameseTitle\}`;\
        select.appendChild(opt);\
      \});\
      onPromptSelectChange();\
    \}\
\
    function onPromptSelectChange() \{\
      const idx = document.getElementById('prompt-select').value;\
      const selected = espTopics[idx];\
      document.getElementById('custom-prompt-input').value = `$\{selected.title\}\\n($\{selected.notes\})`;\
    \}\
\
    function loadTopicAndPractice(idx) \{\
      switchTab('practice');\
      document.getElementById('prompt-select').value = idx;\
      onPromptSelectChange();\
    \}\
\
    function setPracticeMode(mode) \{\
      practiceMode = mode;\
      const typeBtn = document.getElementById('mode-type-btn');\
      const uploadBtn = document.getElementById('mode-upload-btn');\
      const typeContainer = document.getElementById('type-mode-container');\
      const uploadContainer = document.getElementById('upload-mode-container');\
\
      if (mode === 'type') \{\
        typeBtn.className = "px-3 py-1 text-xs font-bold rounded-md bg-brand-600 text-white transition-all";\
        uploadBtn.className = "px-3 py-1 text-xs font-bold rounded-md text-slate-400 hover:text-white transition-all";\
        typeContainer.classList.remove('hidden');\
        uploadContainer.classList.add('hidden');\
      \} else \{\
        uploadBtn.className = "px-3 py-1 text-xs font-bold rounded-md bg-brand-600 text-white transition-all";\
        typeBtn.className = "px-3 py-1 text-xs font-bold rounded-md text-slate-400 hover:text-white transition-all";\
        uploadContainer.classList.remove('hidden');\
        typeContainer.classList.add('hidden');\
      \}\
    \}\
\
    function updateLiveStats() \{\
      const text = document.getElementById('essay-editor').value;\
      \
      // Calculate words\
      const words = text.trim() ? text.trim().split(/\\s+/).length : 0;\
      \
      // Calculate paragraphs\
      const paragraphs = text.split(/\\n+/).filter(p => p.trim().length > 0).length;\
      \
      // Calculate sentences\
      const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;\
\
      document.getElementById('live-word-count').textContent = `$\{words\} t\uc0\u7915  | $\{paragraphs\} \u273 o\u7841 n | $\{sentences\} c\'e2u`;\
\
      // Update diagnostic metrics based on PDF rules\
      const diagWords = document.getElementById('diag-words');\
      const diagParas = document.getElementById('diag-paras');\
      const diagSents = document.getElementById('diag-sents');\
\
      diagWords.innerHTML = `\uc0\u272 \u7897  d\'e0i: <span class="font-bold $\{words >= 280 && words <= 350 ? 'text-emerald-400' : 'text-amber-400'\}">$\{words\} / 300 t\u7915 </span>`;\
      diagParas.innerHTML = `S\uc0\u7889  \u273 o\u7841 n: <span class="font-bold $\{paragraphs >= 4 && paragraphs <= 5 ? 'text-emerald-400' : 'text-amber-400'\}">$\{paragraphs\} / 4-5 \u273 o\u7841 n</span>`;\
      diagSents.innerHTML = `T\uc0\u7893 ng c\'e2u: <span class="font-bold $\{sentences >= 13 ? 'text-emerald-400' : 'text-rose-400'\}">$\{sentences\} / min 13 c\'e2u</span>`;\
    \}\
\
