        btn.className = "text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-2 py-0.5 rounded";\
      \} else \{\
        btn.textContent = "T\uc0\u7841 m d\u7915 ng";\
        btn.className = "text-xs bg-amber-600 hover:bg-amber-500 text-white px-2 py-0.5 rounded";\
        timerInterval = setInterval(() => \{\
          if (timerSeconds > 0) \{\
            timerSeconds--;\
            const mins = Math.floor(timerSeconds / 60);\
            const secs = timerSeconds % 60;\
            document.getElementById('timer-display').textContent = \
              `$\{mins.toString().padStart(2, '0')\}:$\{secs.toString().padStart(2, '0')\}`;\
          \} else \{\
            clearInterval(timerInterval);\
            timerInterval = null;\
            showNotification("H\uc0\u7871 t gi\u7901  l\'e0m b\'e0i! H\'e3y b\u7845 m n\'fat Ch\u7845 m \u272 i\u7875 m AI.");\
          \}\
        \}, 1000);\
      \}\
    \}\
\
    function clearEditor() \{\
      document.getElementById('essay-editor').value = '';\
      updateLiveStats();\
    \}\
\
    function handleFileSelect(e) \{\
      const file = e.target.files[0];\
      if (!file) return;\
      processFile(file);\
    \}\
\
    // Drag and drop setup\
    const dropZone = document.getElementById('drop-zone');\
    dropZone.addEventListener('dragover', (e) => \{ e.preventDefault(); dropZone.classList.add('border-brand-500'); \});\
    dropZone.addEventListener('dragleave', () => \{ dropZone.classList.remove('border-brand-500'); \});\
    dropZone.addEventListener('drop', (e) => \{\
      e.preventDefault();\
      dropZone.classList.remove('border-brand-500');\
      if (e.dataTransfer.files.length > 0) processFile(e.dataTransfer.files[0]);\
    \});\
    dropZone.addEventListener('click', () => \{ document.getElementById('image-input').click(); \});\
\
    function processFile(file) \{\
      uploadedFileMime = file.type;\
      document.getElementById('file-name').textContent = file.name;\
      \
      const reader = new FileReader();\
      reader.onload = function(e) \{\
        uploadedFileBase64 = e.target.result.split(',')[1];\
        if (file.type.startsWith('image/')) \{\
          document.getElementById('image-preview').src = e.target.result;\
        \} else \{\
          document.getElementById('image-preview').src = 'https://placehold.co/100x100/1e293b/ffffff?text=PDF';\
        \}\
        document.getElementById('image-preview-card').classList.remove('hidden');\
      \};\
      reader.readAsDataURL(file);\
    \}\
\
    function removeUploadedFile() \{\
      uploadedFileBase64 = null;\
      uploadedFileMime = null;\
      document.getElementById('image-input').value = '';\
      document.getElementById('image-preview-card').classList.add('hidden');\
    \}\
\
    function showFormula(type) \{\
      document.querySelectorAll('.formula-tab-btn').forEach(btn => \{\
        btn.className = "formula-tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700";\
      \});\
      document.getElementById(`btn-f-$\{type\}`).className = "formula-tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-indigo-600 text-white shadow";\
      renderFormula(type);\
    \}\
\
    function renderFormula(type) \{\
      const data = formulaData[type];\
      const container = document.getElementById('formula-content-container');\
      \
      let html = `\
        <div class="glass-card p-6 rounded-2xl space-y-4 border-slate-700">\
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">\
            <h3 class="text-lg font-bold text-white">$\{data.title\}</h3>\
            <span class="px-3 py-1 text-xs font-bold rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 w-fit">$\{data.badge\}</span>\
          </div>\
          <p class="text-xs text-slate-300 leading-relaxed">$\{data.desc\}</p>\
          \
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">\
      `;\
\
      data.structure.forEach(sec => \{\
        html += `\
          <div class="bg-slate-900/80 p-4 rounded-xl border border-slate-800 space-y-2">\
            <div class="font-bold text-brand-400 text-xs border-b border-slate-800 pb-1">$\{sec.section\}</div>\
            <ul class="space-y-1.5 text-xs text-slate-300">\
        `;\
        sec.items.forEach(item => \{\
          html += `<li class="flex items-start"><i class="fa-solid fa-chevron-right text-[10px] text-slate-500 mt-1 mr-2"></i><span>$\{item\}</span></li>`;\
        \});\
        html += `</ul></div>`;\
      \});\
\
      html += `</div>\
        <div class="bg-slate-900/90 p-4 rounded-xl border border-slate-800 space-y-2 mt-4">\
          <div class="font-bold text-amber-400 text-xs"><i class="fa-solid fa-quote-left mr-2"></i>M\uc0\u7851 u C\u7909 m T\u7915  & M\u7851 u C\'e2u Hay Cho ESP233:</div>\
          <div class="space-y-1.5 text-xs text-slate-300">\
      `;\
\
      data.samplePhrases.forEach(phrase => \{\
        html += `<p class="p-2 bg-slate-950/60 rounded border border-slate-800 font-mono text-slate-200">$\{phrase\}</p>`;\
      \});\
\
      html += `</div></div></div>`;\
      container.innerHTML = html;\
    \}\
\
    function renderVocab() \{\
      const grid = document.getElementById('vocab-cards-grid');\
      grid.innerHTML = '';\
      vocabData.forEach(item => \{\
        const card = document.createElement('div');\
        card.className = "glass-card p-4 rounded-2xl border-slate-800 space-y-2";\
        card.innerHTML = `\
          <div class="flex justify-between items-start">\
            <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">$\{item.type\}</span>\
          </div>\
          <h4 class="font-bold text-white text-base">$\{item.word\}</h4>\
          <p class="text-xs font-semibold text-brand-400">$\{item.vietnamese\}</p>\
          <p class="text-xs text-slate-400 leading-relaxed">$\{item.definition\}</p>\
          <div class="pt-2 border-t border-slate-800">\
            <p class="text-[11px] text-slate-300 italic font-mono">"$\{item.example\}"</p>\
          </div>\
        `;\
        grid.appendChild(card);\
      \});\
    \}\
\
    async function submitForAiGrading() \{\
      const customPrompt = document.getElementById('custom-prompt-input').value;\
      const textContent = document.getElementById('essay-editor').value;\
\
      if (practiceMode === 'type' && (!textContent || textContent.trim().length < 50)) \{\
        showNotification("Vui l\'f2ng g\'f5 b\'e0i lu\uc0\u7853 n t\u7889 i thi\u7875 u 50 t\u7915  tr\u432 \u7899 c khi g\u7917 i ch\u7845 m!");\
        return;\
      \}\
\
      if (practiceMode === 'upload' && !uploadedFileBase64) \{\
        showNotification("Vui l\'f2ng t\uc0\u7843 i \u7843 nh/PDF b\'e0i l\'e0m l\'ean tr\u432 \u7899 c!");\
        return;\
      \}\
\
      // UI States\
      document.getElementById('ai-output-placeholder').classList.add('hidden');\
      document.getElementById('ai-result-card').classList.add('hidden');\
      document.getElementById('ai-loading').classList.remove('hidden');\
\
      // System Instructions based strictly on TACN.pdf requirements\
      const systemInstruction = `\
You are an expert English examiner for the university course "ESP233 TC-NH" (English for Finance and Banking).\
The user is a candidate with a TOEIC 915 base score taking an intensive writing exam.\
\
STRICT GRADING RULES BASED ON ESP233 GUIDELINES (TACN.pdf):\
1. Target length: ~300 words, organized into 4-5 paragraphs.\
2. Minimum sentences: 13 sentences total (standard distribution e.g., Intro: 3-4, Body 1: 4, Body 2: 4, Conclusion: 2).\
3. Essay Task Types Rules:\
   - "Agree - Disagree": Must take ONE clear stance in Thesis (Agree OR Disagree). DO NOT allow partly agree or neutral fence-sitting.\
   - "Advantages - Disadvantages": Check structure (Adv >> Disadv or Adv << Disadv).\
   - "Discuss both views": Body 1 = View 1, Body 2 = View 2, Body 3 / Conclusion = Personal Stance.\
   - "Cause / Problem - Solution": Body 1 = Cause 1 + Solution 1, Body 2 = Cause 2 + Solution 2.\
4. Structure Rules:\
   - Intro: Hook + Background Info + Thesis Statement.\
   - Body Paras: Topic sentence + at least 3 supporting sentences (using compound/complex sentences) + optional concluding sentence.\
   - Conclusion: Thesis re-statement (MUST use synonyms, no repetition) + 1 final sentence (warning/advice/insight).\
   - Absolute Prohibition: NO notes, NO bullet points.\
5. Vocabulary: Grade against advanced Banking & Financial ESP terms (e.g. liquidity, NPLs, monetary policy, capital adequacy, inflation, digital banking).\
\
Your response MUST be JSON formatted with the following structure:\
\{\
  "overallScore": number (out of 10.0),\
  "gradeBadge": string,\
  "taskType": string,\
  "scores": \{\
    "taskStructure": "X/10",\
    "coherence": "X/10",\
    "vocabulary": "X/10",\
    "grammar": "X/10"\
  \},\
  "detailedFeedbackHtml": "HTML string containing paragraph-by-paragraph breakdown checking compliance with TACN.pdf (Hook, Thesis, Sentence counts, Paragraph counts, Stance consistency)",\
  "upgradesHtml": "HTML string with specific vocabulary upgrades for TOEIC 915+ level and corrected compound/complex sentences"\
\}\
`;\
\
      const userInstruction = `\
Exam Prompt: $\{customPrompt\}\
User Mode: $\{practiceMode\}\
$\{practiceMode === 'type' ? `User Written Essay:\\n$\{textContent\}` : 'User has attached an image/PDF of their handwritten/printed essay. Please transribe the text first, then analyze and grade it.'\}\
`;\
\
      const userKey = localStorage.getItem('esp233_gemini_key') || "";\
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=$\{userKey\}`;\
\
      let parts = [\{ text: userInstruction \}];\
\
      if (practiceMode === 'upload' && uploadedFileBase64) \{\
        parts.push(\{\
          inlineData: \{\
            mimeType: uploadedFileMime || "image/png",\
            data: uploadedFileBase64\
          \}\
        \});\
      \}\
\
      const payload = \{\
        contents: [\{ role: "user", parts: parts \}],\
        systemInstruction: \{ parts: [\{ text: systemInstruction \}] \},\
        generationConfig: \{\
          responseMimeType: "application/json"\
        \}\
      \};\
\
      try \{\
        const response = await fetch(apiUrl, \{\
          method: 'POST',\
          headers: \{ 'Content-Type': 'application/json' \},\
          body: JSON.stringify(payload)\
        \});\
\
        if (!response.ok) \{\
          throw new Error(`API response status: $\{response.status\}`);\
        \}\
\
        const data = await response.json();\
        const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;\
        \
        if (jsonText) \{\
          const result = JSON.parse(jsonText);\
          displayAiResults(result);\
        \} else \{\
          throw new Error("Invalid response format from AI model");\
        \}\
      \} catch (err) \{\
        console.error("AI Grading error:", err);\
        displayFallbackResult();\
      \} finally \{\
        document.getElementById('ai-loading').classList.add('hidden');\
      \}\
    \}\
\
    function displayAiResults(res) \{\
      document.getElementById('res-score').textContent = res.overallScore.toFixed(1);\
      document.getElementById('res-grade-badge').textContent = res.gradeBadge || "\uc0\u272 \u7841 t Chu\u7849 n ESP233";\
      document.getElementById('res-task-type').textContent = res.taskType || "ESP Essay";\
\
      document.getElementById('score-task').textContent = res.scores.taskStructure;\
      document.getElementById('score-coherence').textContent = res.scores.coherence;\
      document.getElementById('score-vocab').textContent = res.scores.vocabulary;\
      document.getElementById('score-grammar').textContent = res.scores.grammar;\
\
      document.getElementById('res-detailed-feedback').innerHTML = res.detailedFeedbackHtml;\
      document.getElementById('res-upgrades').innerHTML = res.upgradesHtml;\
\
      document.getElementById('ai-result-card').classList.remove('hidden');\
    \}\
\
    function displayFallbackResult() \{\
      // Fallback display if offline or API key missing\
      const text = document.getElementById('essay-editor').value;\
      const wordCount = text.trim() ? text.trim().split(/\\s+/).length : 0;\
      const sentCount = text.split(/[.!?]+/).filter(s => s.trim().length > 0).length;\
\
      const fallback = \{\
        overallScore: 8.0,\
        gradeBadge: "Kh\'e1 - T\uc0\u7889 t (C\u7847 n l\u432 u \'fd chu\u7849 n c\'e2u)",\
        taskType: "Agree / Disagree",\
        scores: \{\
          taskStructure: "8.0/10",\
          coherence: "8.0/10",\
          vocabulary: "8.0/10",\
          grammar: "8.0/10"\
        \},\
        detailedFeedbackHtml: `\
          <p class="text-amber-400 font-bold mb-1"><i class="fa-solid fa-triangle-exclamation mr-1"></i>\uc0\u272 \'e3 ph\'e2n t\'edch c\u7845 u tr\'fac nhanh (Offline Mode):</p>\
          <ul class="space-y-1 list-disc list-inside">\
            <li><strong>\uc0\u272 \u7897  d\'e0i:</strong> $\{wordCount\} t\u7915  (M\u7909 c ti\'eau chu\u7849 n: ~300 t\u7915 ).</li>\
            <li><strong>S\uc0\u7889  c\'e2u:</strong> $\{sentCount\} c\'e2u (Quy t\u7855 c PDF: t\u7889 i thi\u7875 u 13 c\'e2u).</li>\
            <li><strong>\uc0\u272 \u7897  nh\u7845 t qu\'e1n l\u7853 p tr\u432 \u7901 ng:</strong> \u272 \u7843 m b\u7843 o ch\u7881  ch\u7885 n 1 quan \u273 i\u7875 m \u273 \u7891 ng \'fd ho\u7863 c kh\'f4ng \u273 \u7891 ng \'fd.</li>\
            <li><strong>M\uc0\u7903  b\'e0i:</strong> C\u7847 n \u273 \u7911  3 th\'e0nh ph\u7847 n: Hook + Background Info + Thesis Statement.</li>\
          </ul>\
        `,\
        upgradesHtml: `\
          <p><strong>G\uc0\u7907 i \'fd n\'e2ng c\u7845 p t\u7915  v\u7921 ng ESP233:</strong> Thay th\u7871  c\'e1c t\u7915  th\'f4ng th\u432 \u7901 ng b\u7857 ng thu\u7853 t ng\u7919  ng\'e2n h\'e0ng:</p>\
          <p class="font-mono text-xs text-brand-300 mt-1">&bull; "bad money" &rarr; "non-performing loans (NPLs)"<br>&bull; "bank safety" &rarr; "capital adequacy ratio (CAR)"</p>\
        `\
      \};\
      displayAiResults(fallback);\
    \}\
\
    /* Modal & Helper Functions */\
    function openApiKeyModal() \{\
      document.getElementById('api-key-modal').classList.remove('hidden');\
      const savedKey = localStorage.getItem('esp233_gemini_key') || "";\
      document.getElementById('custom-api-key').value = savedKey;\
      updateKeyStatusText(savedKey);\
    \}\
\
    function closeApiKeyModal() \{\
      document.getElementById('api-key-modal').classList.add('hidden');\
    \}\
\
    function toggleKeyVisibility() \{\
      const input = document.getElementById('custom-api-key');\
      const icon = document.getElementById('key-vis-icon');\
      const text = document.getElementById('key-vis-text');\
      if (input.type === 'password') \{\
        input.type = 'text';\
        icon.className = 'fa-solid fa-eye-slash mr-1';\
        text.textContent = '\uc0\u7848 n Key';\
      \} else \{\
        input.type = 'password';\
        icon.className = 'fa-solid fa-eye mr-1';\
        text.textContent = 'Hi\uc0\u7879 n Key';\
      \}\
    \}\
\
    function clearApiKeyInput() \{\
      document.getElementById('custom-api-key').value = '';\
    \}\
\
    function removeApiKey() \{\
      localStorage.removeItem('esp233_gemini_key');\
      document.getElementById('custom-api-key').value = '';\
      updateKeyStatusText('');\
      showNotification("\uc0\u272 \'e3 x\'f3a API Key th\'e0nh c\'f4ng!");\
    \}\
\
    function updateKeyStatusText(key) \{\
      const statusEl = document.getElementById('api-key-status');\
      if (key && key.trim().length > 0) \{\
        statusEl.className = 'text-[11px] text-emerald-400 font-medium';\
        statusEl.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i>\uc0\u272 \'e3 l\u432 u API Key c\'e1 nh\'e2n trong tr\'ecnh duy\u7879 t.';\
      \} else \{\
        statusEl.className = 'text-[11px] text-slate-400 italic';\
        statusEl.textContent = 'Ch\uc0\u432 a l\u432 u Key c\'e1 nh\'e2n. Tr\'ecnh duy\u7879 t s\u7869  th\u7917  d\'f9ng API m\u7863 c \u273 \u7883 nh.';\
      \}\
    \}\
\
    function saveApiKey() \{\
      const key = document.getElementById('custom-api-key').value.trim();\
      localStorage.setItem('esp233_gemini_key', key);\
      updateKeyStatusText(key);\
      closeApiKeyModal();\
      showNotification("\uc0\u272 \'e3 l\u432 u API Key th\'e0nh c\'f4ng!");\
    \}\
\
    function showNotification(msg) \{\
      const toast = document.createElement('div');\
      toast.className = "fixed bottom-5 right-5 bg-slate-800 text-slate-100 border border-brand-500/40 px-4 py-3 rounded-xl shadow-2xl z-50 text-xs font-semibold flex items-center space-x-2 transition-all";\
      toast.innerHTML = `<i class="fa-solid fa-bell text-brand-400"></i><span>$\{msg\}</span>`;\
      document.body.appendChild(toast);\
      setTimeout(() => toast.remove(), 3500);\
    \}\
  </script>\
